# .env.production — copiar a .env.production en el servidor y completar.
# Este archivo NO se sube al repositorio (se gestiona en el VPS).

NODE_ENV=production
PORT=3000

# MongoDB (corre en Docker en el host, loopback). El server usa network_mode: host.
MONGO_URI=mongodb://127.0.0.1:27017/catalogo

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=GENERAR_Y_REEMPLAZAR
JWT_REFRESH_SECRET=GENERAR_Y_REEMPLAZAR
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# SMTP (para emails de verificación, reset y notificaciones)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@catalogo.appco.com.co

# URL del frontend (para links en emails y CORS)
CLIENT_URL=https://catalogo.appco.com.co

# Super admin (para el seed)
ADMIN_EMAIL=admin@catalogo.appco.com.co
ADMIN_PASSWORD=GENERAR_Y_REEMPLAZAR
