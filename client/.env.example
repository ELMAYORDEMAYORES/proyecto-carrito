# .env.example — copiar a .env si hace falta (normalmente no es necesario)

# URL del backend. Dejarla VACÍA para usar el mismo origen:
#  - En desarrollo: el proxy de Vite reenvía /api y /uploads al backend (localhost:3000).
#  - En producción: Nginx sirve el frontend y proxya /api y /uploads al backend.
# Si el backend está en otro dominio, usar por ejemplo: https://api.tudominio.com
VITE_API_URL=
