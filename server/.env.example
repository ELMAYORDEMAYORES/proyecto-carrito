# .env.example — copiar a .env y completar

# Base de datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalogo_saas?schema=public

# JWT
JWT_ACCESS_SECRET=generate-a-random-secret-here
JWT_REFRESH_SECRET=generate-another-random-secret-here
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# SMTP (Mailtrap para desarrollo)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-password
SMTP_FROM=noreply@catalogo-saas.com

# URL del frontend (para links en emails)
CLIENT_URL=http://localhost:5173

# Puerto
PORT=3000
NODE_ENV=development
