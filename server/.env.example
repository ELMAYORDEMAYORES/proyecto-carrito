# .env.example — copiar a .env y completar

# Entorno
NODE_ENV=development
PORT=3000

# Base de datos (MongoDB)
# Dev (túnel SSH): mongodb://localhost:27017/catalogo_dev
# Producción: mongodb://localhost:27017/catalogo
MONGO_URI=mongodb://localhost:27017/catalogo_dev

# JWT (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=generate-a-random-secret-here
JWT_REFRESH_SECRET=generate-another-random-secret-here
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# SMTP (Mailtrap para desarrollo)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-password
SMTP_FROM=noreply@catalogo-saas.com

# URL del frontend (para links en emails)
CLIENT_URL=http://localhost:5173

# Super admin (para el script de seed)
ADMIN_EMAIL=admin@catalogo.com
ADMIN_PASSWORD=AdminPass123!
